{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'section-collection-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign archive_title = collection.title
  assign archive_description = collection.description

  if collection.handle == 'all'
    if section.settings.all_collection_title != blank
      assign archive_title = section.settings.all_collection_title
    endif
    if archive_description == blank and section.settings.all_collection_description != blank
      assign archive_description = section.settings.all_collection_description
    endif
  endif
-%}

<section class="os-collection-intro color-{{ section.settings.color_scheme }}">
  <div class="os-collection-intro__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="os-collection-intro__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="os-collection-intro__title">{{ archive_title | escape }}</h1>
    {%- if section.settings.show_collection_description and archive_description != blank -%}
      <div class="os-collection-intro__description rte">{{ archive_description }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection intro",
  "class": "section section-collection-archive",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "all_collection_title",
      "label": "All-products title",
      "default": "ALL PRODUCTS"
    },
    {
      "type": "textarea",
      "id": "all_collection_description",
      "label": "All-products description",
      "default": "Explore every piece from Our Stupidity."
    },
    {
      "type": "text",
      "id": "watermark",
      "label": "Watermark",
      "default": "全商品"
    },
    {
      "type": "text",
      "id": "chapter_label",
      "label": "Chronicle label",
      "default": "DROP 001"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "Show collection description"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "Show collection image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
