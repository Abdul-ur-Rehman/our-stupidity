{% doc %}
  Renders the mobile brand navigation.

  @param {string} menu_type_desktop - Desktop navigation type.
  @param {string} menu_color_scheme - Drawer color scheme.
{% enddoc %}

{%- liquid
  assign about_url = pages['brand-story'].url | default: '/pages/brand-story'
  assign contact_url = pages.contact.url | default: '/pages/contact'
-%}

<header-drawer data-breakpoint="{% if menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation" aria-label="Mobile navigation">
            <ul class="menu-drawer__menu list-menu" role="list">
              <li>
                <a href="{{ routes.all_products_collection_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                  Shop
                </a>
              </li>
              <li>
                <a href="{{ about_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                  About
                </a>
              </li>
              <li>
                <a href="{{ contact_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                  Contact
                </a>
              </li>
              <li class="os-mobile-menu__utility os-mobile-menu__utility--first">
                <a href="{{ routes.search_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                  <span class="svg-wrapper">{{- 'icon-search.svg' | inline_asset_content -}}</span>
                  Search
                </a>
              </li>
              {%- if shop.customer_accounts_enabled -%}
                <li class="os-mobile-menu__utility">
                  <a href="{{ routes.account_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                    <span class="svg-wrapper">{{- 'icon-account.svg' | inline_asset_content -}}</span>
                    Profile
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
