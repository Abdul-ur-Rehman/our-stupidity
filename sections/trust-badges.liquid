{%- style -%}
  #shopify-section-{{ section.id }} .trust-grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr);
    gap: 2px;
    background: var(--os-border);
    border-top: 2px solid var(--os-border);
  }
  #shopify-section-{{ section.id }} .trust-item {
    background: var(--os-surface);
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }
  #shopify-section-{{ section.id }} .trust-icon {
    color: var(--os-gold);
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .trust-icon svg {
    display: block;
  }
  #shopify-section-{{ section.id }} .trust-title {
    font-family: var(--os-font-d);
    font-size: 16px;
    letter-spacing: 0.08em;
    color: var(--os-text);
    text-transform: uppercase;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .trust-body {
    font-size: 12px;
    line-height: 1.55;
    color: var(--os-text-muted);
    max-width: 160px;
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .trust-grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div class="trust-grid" role="list" aria-label="{{ section.settings.accessibility_label | default: 'Trust badges' }}">
  {%- for block in section.blocks -%}
    <div class="trust-item" role="listitem" {{ block.shopify_attributes }}>
      <div class="trust-icon" aria-hidden="true">
        {{- block.settings.icon -}}
      </div>
      <p class="trust-title">{{ block.settings.title | escape }}</p>
      <p class="trust-body">{{ block.settings.text | escape }}</p>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Trust badges"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon SVG",
          "default": "<svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Quality"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "300GSM heavyweight cotton. Built to outlast trends."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        {
