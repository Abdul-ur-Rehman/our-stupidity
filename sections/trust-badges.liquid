{%- style -%}
  #shopify-section-{{ section.id }} {
    border-top: 1px solid rgba(201, 168, 76, 0.34);
    border-bottom: 1px solid rgba(201, 168, 76, 0.18);
    background:
      radial-gradient(circle at 50% 0%, rgba(201, 168, 76, 0.055), transparent 42%),
      #080808;
  }
  #shopify-section-{{ section.id }} .trust-grid {
    display: grid;
    width: min(calc(100% - 8rem), 136rem);
    margin: 0 auto;
    padding: 3.2rem 0;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr);
    gap: 1rem;
  }
  #shopify-section-{{ section.id }} .trust-item {
    display: grid;
    min-height: 13rem;
    padding: 2.2rem;
    grid-template-columns: 4rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-content: center;
    gap: 0.55rem 1.4rem;
    border: 1px solid #252525;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.022), transparent 62%), #0c0c0c;
    text-align: left;
    transition: border-color 180ms ease, transform 180ms ease;
  }
  #shopify-section-{{ section.id }} .trust-icon {
    display: grid;
    width: 4rem;
    height: 4rem;
    grid-row: 1 / 3;
    place-items: center;
    color: var(--os-gold);
  }
  #shopify-section-{{ section.id }} .trust-icon svg {
    display: block;
    width: 3.2rem;
    height: 3.2rem;
    stroke: currentColor !important;
  }
  #shopify-section-{{ section.id }} .trust-title {
    margin: 0;
    font-family: var(--os-font-d);
    font-size: 1.35rem;
    letter-spacing: 0.07em;
    color: var(--os-text);
    text-transform: uppercase;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .trust-body {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--os-text-muted);
  }
  @media (hover: hover) {
    #shopify-section-{{ section.id }} .trust-item:hover {
      border-color: rgba(201, 168, 76, 0.52);
      transform: translateY(-2px);
    }
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .trust-grid {
      width: calc(100% - 3rem);
      padding: 2.4rem 0;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.8rem;
    }
  }
  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .trust-item {
      display: flex;
      min-height: 15.5rem;
      padding: 1.8rem 1.2rem;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .trust-icon { width: 3.4rem; height: 3.4rem; }
    #shopify-section-{{ section.id }} .trust-icon svg { width: 2.8rem; height: 2.8rem; }
    #shopify-section-{{ section.id }} .trust-title { font-size: 1.2rem; }
    #shopify-section-{{ section.id }} .trust-body { font-size: 0.94rem; }
  }
{%- endstyle -%}

<div class="trust-grid" role="list" aria-label="{{ section.settings.accessibility_label | default: 'Trust badges' }}">
  {%- for block in section.blocks -%}
    <div class="trust-item" role="listitem" {{ block.shopify_attributes }}>
      <div class="trust-icon" aria-hidden="true">
        {{- block.settings.icon -}}
      </div>
      <p class="trust-title">{{ block.settings.title | escape }}</p>
      <p class="trust-body">{{ block.settings.text | escape }}</p>
    </div>
  {%- endfor -%}
</div>

{% schema %}
