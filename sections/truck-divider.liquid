{%- style -%}
  #shopify-section-{{ section.id }} .divider-truck {
    height: 52px;
    position: relative;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .divider-truck-bg {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(45deg, rgba(227,0,15,0.07) 0px, rgba(227,0,15,0.07) 1px, transparent 1px, transparent 12px),
      repeating-linear-gradient(-45deg, rgba(227,0,15,0.07) 0px, rgba(227,0,15,0.07) 1px, transparent 1px, transparent 12px);
  }
  #shopify-section-{{ section.id }} .divider-truck-line {
    position: absolute;
    top: 50%;
    left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--os-red) 20%, var(--os-gold) 50%, var(--os-red) 80%, transparent 100%);
  }
  #shopify-section-{{ section.id }} .divider-truck-border-t,
  #shopify-section-{{ section.id }} .divider-truck-border-b {
    position: absolute;
    left: 0; right: 0;
    height: 1px;
    background: var(--os-border);
  }
  #shopify-section-{{ section.id }} .divider-truck-border-t { top: 0; }
  #shopify-section-{{ section.id }} .divider-truck-border-b { bottom: 0; }
{%- endstyle -%}

<div class="divider-truck" aria-hidden="true">
  <div class="divider-truck-bg"></div>
  <div class="divider-truck-line"></div>
  <div class="divider-truck-border-t"></div>
  <div class="divider-truck-border-b"></div>
</div>

{% schema %}
{
  "name": "Truck Art Divider",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Truck Art Divider"
    }
  ]
}
{% endschema %}
