{%- liquid
  assign lc   = section.settings.line_color
  assign lc_r = lc | color_extract: 'red'
  assign lc_g = lc | color_extract: 'green'
  assign lc_b = lc | color_extract: 'blue'
  assign op   = section.settings.pattern_opacity | divided_by: 100.0 | round: 2
  assign ht   = section.settings.divider_height
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    display: block;
    padding: 0 !important;
    margin: 0 !important;
    line-height: 0;
  }
  #shopify-section-{{ section.id }} .td-wrap {
    height: {{ ht }}px;
    position: relative;
    overflow: hidden;
    background: #0d0d0d;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  #shopify-section-{{ section.id }} .td-pattern {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        45deg,
        rgba({{ lc_r }}, {{ lc_g }}, {{ lc_b }}, {{ op }}) 0px,
        rgba({{ lc_r }}, {{ lc_g }}, {{ lc_b }}, {{ op }}) 2px,
        transparent 2px,
        transparent 22px
      ),
      repeating-linear-gradient(
        -45deg,
        rgba({{ lc_r }}, {{ lc_g }}, {{ lc_b }}, {{ op }}) 0px,
        rgba({{ lc_r }}, {{ lc_g }}, {{ lc_b }}, {{ op }}) 2px,
        transparent 2px,
        transparent 22px
      );
  }
  #shopify-section-{{ section.id }} .td-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
    background: linear-gradient(90deg,
      {{ lc }} 0%,
      {{ lc }} 35%,
      #C9A84C  50%,
      {{ lc }} 65%,
      {{ lc }} 100%
    );
  }
{%- endstyle -%}

<div class="td-wrap" aria-hidden="true">
  <div class="td-pattern"></div>
  <div class="td-line"></div>
</div>

{% schema %}
{
  "name": "Truck Art Divider",
  "tag": "div",
  "settings": [
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#E3000F"
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "label": "Pattern opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "divider_height",
      "label": "Height",
      "min": 40,
      "max": 160,
      "step": 4,
      "default": 80,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Truck Art Divider"
    }
  ]
}
{% endschema %}
