{%- liquid
  assign shop_active = false
  if request.page_type == 'index'
    assign shop_active = true
  endif
  assign about_url = pages['brand-story'].url | default: '/pages/brand-story'
  assign contact_url = pages.contact.url | default: '/pages/contact'
-%}

<nav class="header__inline-menu os-header-nav" aria-label="Main navigation">
  <ul class="list-menu list-menu--inline os-header-menu" role="list">
    <li>
      <a
        href="{{ routes.root_url }}#shop-collection"
        data-shop-collection-link
        class="header__menu-item list-menu__item link link--text focus-inset{% if shop_active %} header__menu-item--active{% endif %}"
        {% if shop_active %}aria-current="page"{% endif %}
      >
        <span>Shop</span>
      </a>
    </li>
    <li>
      <a
        href="{{ about_url }}"
        class="header__menu-item list-menu__item link link--text focus-inset{% if request.page_type == 'page' and page.handle == 'brand-story' %} header__menu-item--active{% endif %}"
        {% if request.page_type == 'page' and page.handle == 'brand-story' %}aria-current="page"{% endif %}
      >
        <span>About</span>
      </a>
    </li>
    <li>
      <a
        href="{{ contact_url }}"
        class="header__menu-item list-menu__item link link--text focus-inset{% if request.page_type == 'page' and page.handle == 'contact' %} header__menu-item--active{% endif %}"
        {% if request.page_type == 'page' and page.handle == 'contact' %}aria-current="page"{% endif %}
      >
        <span>Contact</span>
      </a>
    </li>
  </ul>
</nav>
