        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Quality"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "300GSM heavyweight cotton. Built to outlast trends."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        {
