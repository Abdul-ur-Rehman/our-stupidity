<div class="trust-badges page-width animate-fade-up">
  {%- for block in section.blocks -%}
    <div class="trust-badge" {{ block.shopify_attributes }}>
      {%- if block.settings.icon != blank -%}
        <div class="trust-badge__icon">{{ block.settings.icon }}</div>
      {%- endif -%}
      <strong>{{ block.settings.title }}</strong>
      <span>{{ block.settings.text }}</span>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon SVG",
          "default": "<svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E3000F\" stroke-width=\"1.5\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "PREMIUM QUALITY"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "200 GSM heavy cotton for everyday wear."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "<svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E3000F\" stroke-width=\"1.5\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>",
            "title": "PREMIUM QUALITY",
            "text": "200 GSM heavy cotton for everyday wear."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "<svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E3000F\" stroke-width=\"1.5\"><polyline points=\"1 4 1 10 7 10\"/><path d=\"M3.51 15a9 9 0 1 0 .49-3.16\"/></svg>",
            "title": "EASY RETURNS",
            "text": "Hassle-free returns within 7 days."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "<svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E3000F\" stroke-width=\"1.5\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/></svg>",
            "title": "SECURE PAYMENT",
            "text": "Safe & secure checkout guaranteed."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "<svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E3000F\" stroke-width=\"1.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>",
            "title": "LIMITED DROPS",
            "text": "No restocks. Once it's gone, it's gone."
          }
        }
      ]
    }
  ]
}
{% endschema %}
