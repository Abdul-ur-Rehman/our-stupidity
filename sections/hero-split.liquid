{%- style -%}
  .os-hero {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-height: var(--hero-min-height, calc(100svh - 106px));
    background: #080808;
    border-top: 1px solid #C9A84C;
    overflow: hidden;
    position: relative;
  }

  .os-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px var(--os-gutter);
    background: linear-gradient(90deg, #080808 65%, transparent 100%);
    position: relative;
    overflow: hidden;
    z-index: 4;
  }

  .os-hero__watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(80px, 14vw, 200px);
    font-weight: 700;
    color: #ffffff;
    opacity: 0.03;
    white-space: nowrap;
    line-height: 1;
    letter-spacing: -0.02em;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* Eyebrow — Inter not Bebas: matches the thinner, spaced-out look in the design */
  .os-hero__eyebrow {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: #C9A84C;
    margin: 0 0 20px;
    text-transform: uppercase;
  }

  /* Headline — Bebas Neue, tight line-height, sized so "DIFFERENT" fills the column */
  .os-hero__headline {
    font-family: 'Bebas Neue', Impact, sans-serif;
    font-size: clamp(60px, 7.5vw, 100px);
    line-height: 0.91;
    letter-spacing: 0.02em;
    color: #F5F0E8;
    margin: 0;
    text-transform: uppercase;
  }

  .os-hero__headline-red {
    color: #E3000F;
    display: block;
  }

  .os-hero__rule {
    width: 56px;
    height: 2px;
    background: #C9A84C;
    margin: 28px 0;
    flex-shrink: 0;
  }

  .os-hero__subtext {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.8;
    color: #6B6B6B;
    margin: 0 0 40px;
    max-width: 340px;
  }

  .os-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .os-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 28px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.18em;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 0;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
  }

  .os-hero__btn--primary {
    background: #E3000F;
    color: #ffffff;
    border: 1px solid #E3000F;
  }

  .os-hero__btn--primary:hover {
    background: #b8000c;
    border-color: #b8000c;
  }

  .os-hero__media {
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  /* Color fade from dark panel into image — wider than before to pair with the blur strip */
  .os-hero__media::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #080808 0%,
      rgba(8,8,8,0.5) 10%,
      rgba(8,8,8,0.12) 26%,
      transparent 42%
    );
    z-index: 1;
    pointer-events: none;
  }

  /* Gold hairline on far right edge */
  .os-hero__media::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 1px;
    background: #C9A84C;
    z-index: 2;
    opacity: 0.55;
  }

  /* Images fill the panel absolutely so desktop + mobile can coexist in the DOM */
  .os-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: var(--hero-img-fit, cover);
    object-position: var(--hero-img-pos, center center);
    display: block;
  }

  .os-hero__jp-text {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    font-family: 'Noto Serif JP', serif;
    font-size: 10px;
    letter-spacing: 0.32em;
    color: rgba(201, 168, 76, 0.4);
    z-index: 3;
    white-space: nowrap;
    pointer-events: none;
  }

  @media screen and (max-width: 900px) {
    .os-hero {
      display: block;
      min-height: 90svh;
    }

    .os-hero__content {
      min-height: 90svh;
      padding: 60px var(--os-gutter);
      justify-content: flex-end;
      background: linear-gradient(180deg, transparent 20%, rgba(8, 8, 8, 0.72) 58%, #080808 82%);
      z-index: 3;
    }

    .os-hero__media {
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .os-hero__media::before {
      background: none;
    }

    .os-hero__img {
      object-position: center top;
    }

    .os-hero__subtext {
      max-width: min(340px, 100%);
      overflow-wrap: anywhere;
    }

    .os-hero__jp-text {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .os-hero__btn { transition: none; }
  }
{%- endstyle -%}

{%- liquid
  case section.settings.section_height
    when 'short'
      assign hero_min_height = 'clamp(480px, 55vh, 600px)'
    when 'medium'
      assign hero_min_height = 'clamp(580px, 68vh, 740px)'
    when 'large'
      assign hero_min_height = 'calc(100svh - 106px)'
    when 'full'
      assign hero_min_height = '100vh'
    else
      assign hero_min_height = 'calc(100svh - 106px)'
  endcase
-%}
<section class="os-hero" style="--hero-min-height: {{ hero_min_height }};">
  <div class="os-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="os-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="os-hero__headline">
      {%- if section.settings.headline_1 != blank -%}
        {{ section.settings.headline_1 | escape }}<br>
      {%- endif -%}
      {%- if section.settings.headline_2 != blank -%}
        {{ section.settings.headline_2 | escape }}<br>
      {%- endif -%}
      {%- if section.settings.headline_3 != blank -%}
        <span class="os-hero__headline-red">{{ section.settings.headline_3 | escape }}</span>
      {%- endif -%}
    </h1>

    <div class="os-hero__rule" aria-hidden="true"></div>

    {%- if section.settings.subtext != blank -%}
      <p class="os-hero__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    <div class="os-hero__buttons">
      {%- if section.settings.btn1_label != blank -%}
        <a href="{{ section.settings.btn1_link | default: routes.collections_url }}" class="os-hero__btn os-hero__btn--primary">
          {{- section.settings.btn1_label | escape -}}
        </a>
      {%- endif -%}
    </div>

  </div>

  {%- liquid
    case section.settings.image_position
      when 'left'
        assign hero_img_fit = 'cover'
        assign hero_img_pos = 'left top'
      when 'right'
        assign hero_img_fit = 'cover'
        assign hero_img_pos = 'right top'
      when 'fit'
        assign hero_img_fit = 'contain'
        assign hero_img_pos = 'center center'
      else
        assign hero_img_fit = 'cover'
        assign hero_img_pos = 'center center'
    endcase
  -%}

  <div class="os-hero__media" style="--hero-img-fit: {{ hero_img_fit }}; --hero-img-pos: {{ hero_img_pos }};">
    {%- if section.settings.image != blank -%}
      {%- assign hero_img_alt = section.settings.image.alt | default: shop.name | escape -%}
      {%- assign desktop_img_class = 'os-hero__img' -%}
      {%- if section.settings.mobile_image != blank -%}
        {%- assign desktop_img_class = 'os-hero__img small-hide' -%}
      {%- endif -%}
      {%- capture hero_widths %}750, 900, 1100, 1400{% endcapture -%}
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag:
          class: desktop_img_class,
          alt: hero_img_alt,
          loading: 'eager',
          fetchpriority: 'high',
          widths: hero_widths
      }}
    {%- endif -%}

    {%- if section.settings.mobile_image != blank -%}
      {%- assign mobile_img_alt = section.settings.mobile_image.alt | default: shop.name | escape -%}
      {{
        section.settings.mobile_image
        | image_url: width: 800
        | image_tag:
          class: 'os-hero__img medium-hide large-hide',
          alt: mobile_img_alt,
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- endif -%}

    {%- unless section.settings.image != blank or section.settings.mobile_image != blank -%}
      <div style="position:absolute;inset:0;background:linear-gradient(135deg,#111 0%,#0a0a0a 100%);"></div>
    {%- endunless -%}

    {%- if section.settings.jp_text != blank -%}
      <span class="os-hero__jp-text" aria-hidden="true">{{ section.settings.jp_text | escape }}</span>
    {%- endif -%}
  </div>

  <span class="os-hero__watermark" aria-hidden="true">我らの愚かさ</span>
</section>

{% schema %}
{
  "name": "Hero Split",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "CHRONICLES: UNSEEN — DROP 001"
    },
    {
      "type": "text",
      "id": "headline_1",
      "label": "Headline line 1",
      "default": "DIFFERENT"
    },
    {
      "type": "text",
      "id": "headline_2",
      "label": "Headline line 2",
      "default": "IS THE"
    },
    {
      "type": "text",
      "id": "headline_3",
      "label": "Headline line 3 (shown in red)",
      "default": "POINT."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Body text",
      "default": "Grit. Discipline. Built for those who create before they conform. No templates. No trends."
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button label",
      "default": "SHOP COLLECTION"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "short",  "label": "Short (~55vh)" },
        { "value": "medium", "label": "Medium (~68vh)" },
        { "value": "large",  "label": "Large (~80vh)" },
        { "value": "full",   "label": "Full screen (100vh)" }
      ],
      "default": "large"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (desktop)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left",   "label": "Left" },
        { "value": "right",  "label": "Right" },
        { "value": "fit",    "label": "Fit to image (no crop)" }
      ],
      "default": "center"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Hero image (mobile, optional)"
    },
    {
      "type": "text",
      "id": "jp_text",
      "label": "Right-edge text",
      "default": "異なることが本質"
    }
  ],
  "presets": [
    {
      "name": "Hero Split"
    }
  ]
}
{% endschema %}
