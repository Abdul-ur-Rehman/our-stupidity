{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

<style>
  .os-footer {
    background: #0a0a0a;
    border-top: 1px solid #C9A84C;
    padding: 80px 0 0;
    position: relative;
  }

  .os-footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  /* ── Top row ── */
  .os-footer__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 4rem;
    padding-bottom: 4rem;
  }

  /* Brand column */
  .os-footer__brand {
    flex: 0 0 auto;
    max-width: 320px;
  }

  .os-footer__logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.8rem;
    letter-spacing: 0.12em;
    color: #ffffff;
    text-decoration: none;
    display: block;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .os-footer__logo span {
    color: #E3000F;
  }

  .os-footer__tagline {
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    color: #666;
    text-transform: uppercase;
    line-height: 1.8;
  }

  /* Nav column */
  .os-footer__nav {
    display: flex;
    gap: 5rem;
    flex: 1;
    justify-content: center;
  }

  .os-footer__nav-group h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.3em;
    color: #C9A84C;
    margin: 0 0 1.5rem;
  }

  .os-footer__nav-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .os-footer__nav-group a {
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    color: #888;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .os-footer__nav-group a:hover { color: #ffffff; }

  /* Social column */
  .os-footer__social {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.5rem;
  }

  .os-footer__tagline-jp {
    font-family: 'Noto Serif JP', serif;
    font-size: 0.85rem;
    color: #C9A84C;
    opacity: 0.7;
    margin-top: 0.75rem;
    display: block;
  }

  .os-footer__social-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.3em;
    color: #C9A84C;
  }

  .os-footer__social-icons {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .os-footer__social-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border: 1px solid #2a2a2a;
    color: #888;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .os-footer__social-icons a:hover {
    border-color: #E3000F;
    color: #ffffff;
    background: rgba(227, 0, 15, 0.08);
  }

  .os-footer__social-icons svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  /* ── Divider ── */
  .os-footer__divider {
    border: none;
    border-top: 1px solid #1c1c1c;
    margin: 0;
  }

  /* ── Bottom bar ── */
  .os-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
    gap: 1rem;
  }

  .os-footer__copy {
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: #555;
    text-transform: uppercase;
  }

  .os-footer__copy a {
    color: #555;
    text-decoration: none;
  }

  .os-footer__policies {
    display: flex;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .os-footer__policies a {
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    color: #555;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .os-footer__policies a:hover { color: #999; }

  .os-footer__kanji {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.1rem;
    color: #C9A84C;
    opacity: 0.6;
    letter-spacing: 0.1em;
  }

  /* ── Payment icons ── */
  .os-footer__payment {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .os-footer__payment .icon { height: 26px; opacity: 0.5; }

  /* ── Mobile ── */
  @media (max-width: 749px) {
    .os-footer {
      padding: 60px 0 0;
    }

    .os-footer__top {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 2.5rem;
    }

    .os-footer__brand {
      max-width: 100%;
    }

    .os-footer__nav {
      flex-direction: column;
      gap: 2rem;
      align-items: center;
    }

    .os-footer__nav-group ul {
      align-items: center;
    }

    .os-footer__social {
      align-items: center;
    }

    .os-footer__bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.75rem;
      padding: 1.5rem 1rem;
    }

    .os-footer__policies {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }
  }
</style>

<footer class="os-footer">

  <div class="os-footer__inner">
    <div class="os-footer__top">

      <!-- Brand -->
      <div class="os-footer__brand">
        <a href="{{ routes.root_url }}" class="os-footer__logo">OUR <span>STUPIDITY</span></a>
        <p class="os-footer__tagline">Born from the stories<br>that changed you.</p>
        <span class="os-footer__tagline-jp">独自性を求める者たちへ</span>
      </div>

      <!-- Nav -->
      <nav class="os-footer__nav" aria-label="Footer navigation">
        <div class="os-footer__nav-group">
          <h3>Shop</h3>
          <ul>
            <li><a href="{{ routes.all_products_collection_url }}">All Products</a></li>
            <li><a href="{{ routes.collections_url }}">Collections</a></li>
            <li><a href="{{ routes.root_url }}pages/about">About</a></li>
            <li><a href="{{ routes.root_url }}pages/contact">Contact</a></li>
          </ul>
        </div>
        <div class="os-footer__nav-group">
          <h3>Customer</h3>
          <ul>
            <li><a href="{{ routes.root_url }}pages/shipping">Shipping</a></li>
            <li><a href="{{ routes.root_url }}pages/returns">Returns</a></li>
            <li><a href="{{ routes.root_url }}pages/faq">FAQ</a></li>
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </nav>

      <!-- Social -->
      <div class="os-footer__social">
        <span class="os-footer__social-label">Follow</span>
        <div class="os-footer__social-icons">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.79a8.18 8.18 0 004.78 1.52V6.86a4.85 4.85 0 01-1.01-.17z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.931-1.956 1.886v2.268h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
            </a>
          {%- endif -%}
          <a href="https://wa.link/i7jfr5" target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>

    </div>
  </div>

  <hr class="os-footer__divider">

  <div class="os-footer__bottom">
    <p class="os-footer__copy">
      &copy; {{ 'now' | date: '%Y' }} <a href="{{ routes.root_url }}">Our Stupidity</a>
    </p>

    <span class="os-footer__kanji" aria-hidden="true">愚か</span>

    {%- if section.settings.payment_enable -%}
      <div class="os-footer__payment">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    { "type": "@app" },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "t:sections.footer.blocks.link_list.settings.heading.default", "label": "t:sections.footer.blocks.link_list.settings.heading.label" },
        { "type": "link_list", "id": "menu", "default": "footer", "label": "t:sections.footer.blocks.link_list.settings.menu.label" }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        { "type": "paragraph", "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content" },
        { "type": "checkbox", "id": "show_social", "default": true, "label": "t:sections.footer.blocks.brand_information.settings.show_social.label", "info": "t:sections.footer.blocks.brand_information.settings.show_social.info" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "t:sections.footer.blocks.text.settings.heading.default", "label": "t:sections.footer.blocks.text.settings.heading.label" },
        { "type": "richtext", "id": "subtext", "default": "t:sections.footer.blocks.text.settings.subtext.default", "label": "t:sections.footer.blocks.text.settings.subtext.label" }
      ]
    }
  ],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "checkbox", "id": "payment_enable", "default": true, "label": "t:sections.footer.settings.payment_enable.label" },
    { "type": "checkbox", "id": "show_policy", "default": true, "label": "t:sections.footer.settings.show_policy.label", "info": "t:sections.footer.settings.show_policy.info" },
    { "type": "checkbox", "id": "newsletter_enable", "default": false, "label": "t:sections.footer.settings.newsletter_enable.label" },
    { "type": "checkbox", "id": "show_social", "default": true, "label": "t:sections.footer.settings.show_social.label", "info": "t:sections.footer.settings.show_social.info" },
    { "type": "checkbox", "id": "enable_follow_on_shop", "default": false, "label": "t:sections.footer.settings.enable_follow_on_shop.label", "info": "t:sections.footer.settings.enable_follow_on_shop.info" },
    { "type": "checkbox", "id": "enable_country_selector", "default": false, "label": "t:sections.footer.settings.enable_country_selector.label", "info": "t:sections.footer.settings.enable_country_selector.info" },
    { "type": "checkbox", "id": "enable_language_selector", "default": false, "label": "t:sections.footer.settings.enable_language_selector.label", "info": "t:sections.footer.settings.enable_language_selector.info" }
  ],
  "default": {
    "blocks": [{ "type": "link_list" }]
  }
}
{% endschema %}
