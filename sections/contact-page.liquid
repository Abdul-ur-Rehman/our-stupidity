{{ 'section-contact-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="os-contact section-{{ section.id }}-padding">
  <div class="os-contact__hero page-width">
    <div class="os-contact__watermark" aria-hidden="true">{{ section.settings.watermark }}</div>
    <div class="os-contact__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="os-contact__eyebrow"><span></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="os-contact__title">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank -%}
          <span>{{ section.settings.heading_accent | escape }}</span>
        {%- endif -%}
      </h1>
      {%- if section.settings.intro != blank -%}
        <div class="os-contact__lead rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    <aside class="os-contact__direct" aria-label="Direct contact information">
      <p class="os-contact__index">01 / DIRECT LINE</p>
      <div class="os-contact__direct-item">
        <span>EMAIL</span>
        <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
      </div>
      {%- if section.settings.whatsapp_url != blank -%}
        <div class="os-contact__direct-item os-contact__direct-item--whatsapp">
          <span>WHATSAPP</span>
          <a class="os-contact__whatsapp" href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener">
            <span>CHAT ON WHATSAPP</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      {%- endif -%}
      <p class="os-contact__direct-note">{{ section.settings.direct_note | escape }}</p>
    </aside>
  </div>

  <div class="os-contact__divider" aria-hidden="true"><span></span></div>

  <div class="os-contact__main page-width">
    <div class="os-contact__form-panel">
      <div class="os-contact__section-heading">
        <p>02 / MESSAGE</p>
        <h2>{{ section.settings.form_heading | escape }}</h2>
        <span>{{ section.settings.form_note | escape }}</span>
      </div>

      {%- form 'contact', id: 'ContactForm', class: 'os-contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="os-contact-form__status os-contact-form__status--success" tabindex="-1" autofocus>
            {{- 'icon-success.svg' | inline_asset_content -}}
            <div>
              <strong>MESSAGE RECEIVED.</strong>
              <span>{{ 'templates.contact.form.post_success' | t }}</span>
            </div>
          </div>
        {%- elsif form.errors -%}
          <div class="os-contact-form__status os-contact-form__status--error" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            <div>
              <strong>CHECK THE FORM.</strong>
              <span>{{ 'templates.contact.form.error_heading' | t }}</span>
            </div>
          </div>
        {%- endif -%}

        <div class="os-contact-form__grid">
          <div class="os-contact-form__field">
            <label for="ContactForm-name">NAME</label>
            <input
              autocomplete="name"
              type="text"
              id="ContactForm-name"
              name="contact[Name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="Your name"
            >
          </div>

          <div class="os-contact-form__field">
            <label for="ContactForm-email">EMAIL <span>*</span></label>
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="you@email.com"
              aria-required="true"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
            >
            {%- if form.errors contains 'email' -%}
              <small id="ContactForm-email-error">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </small>
            {%- endif -%}
          </div>

          <div class="os-contact-form__field">
            <label for="ContactForm-phone">PHONE</label>
            <input
              autocomplete="tel"
              type="tel"
              id="ContactForm-phone"
              name="contact[Phone]"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="Optional"
            >
          </div>

          <div class="os-contact-form__field">
            <label for="ContactForm-order">ORDER NUMBER</label>
            <input
              type="text"
              id="ContactForm-order"
              name="contact[Order number]"
              placeholder="e.g. #1001"
            >
          </div>

          <div class="os-contact-form__field os-contact-form__field--wide">
            <label for="ContactForm-topic">WHAT CAN WE HELP WITH?</label>
            <div class="os-contact-form__select">
              <select id="ContactForm-topic" name="contact[Topic]">
                <option value="Order support">Order support</option>
                <option value="Product and sizing">Product &amp; sizing</option>
                <option value="Returns and exchanges">Returns &amp; exchanges</option>
                <option value="Collaboration">Collaborations</option>
                <option value="Press">Press</option>
                <option value="Something else">Something else</option>
              </select>
              <span aria-hidden="true">⌄</span>
            </div>
          </div>

          <div class="os-contact-form__field os-contact-form__field--wide">
            <label for="ContactForm-body">MESSAGE <span>*</span></label>
            <textarea
              rows="7"
              id="ContactForm-body"
              name="contact[Comment]"
              placeholder="Tell us what happened, what you need, or what you have in mind."
              required
            >{{- form.body -}}</textarea>
          </div>
        </div>

        <div class="os-contact-form__footer">
          <p>By sending this form, you agree to be contacted about your request.</p>
          <button type="submit" class="os-contact-form__submit">
            <span>SEND MESSAGE</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      {%- endform -%}
    </div>

    <aside class="os-contact__support">
      <div class="os-contact__section-heading os-contact__section-heading--support">
        <p>03 / SUPPORT NOTES</p>
        <h2>HELP US HELP YOU.</h2>
      </div>

      <ol class="os-contact__notes">
        <li>
          <span>01</span>
          <div>
            <strong>ORDER SUPPORT</strong>
            <p>Include your order number and the email used at checkout.</p>
          </div>
        </li>
        <li>
          <span>02</span>
          <div>
            <strong>SIZING &amp; PRODUCTS</strong>
            <p>Share the product name and your usual size for a faster answer.</p>
          </div>
        </li>
        <li>
          <span>03</span>
          <div>
            <strong>COLLABORATIONS</strong>
            <p>Tell us about your idea, audience and expected timeline.</p>
          </div>
        </li>
      </ol>

      {%- if settings.social_instagram_link != blank or settings.social_tiktok_link != blank or settings.social_facebook_link != blank -%}
        <div class="os-contact__socials">
          <p>FOLLOW THE CHRONICLE</p>
          <div>
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">INSTAGRAM <span>↗</span></a>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TIKTOK <span>↗</span></a>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">FACEBOOK <span>↗</span></a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </aside>
  </div>

</div>

{% schema %}
{
  "name": "Contact page",
  "tag": "section",
  "class": "section section-contact-page",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OPEN CHANNEL / CUSTOMER SUPPORT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LET'S"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "TALK."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Questions, order support, sizing advice or a strange idea worth sharing—we are listening.</p>"
    },
    {
      "type": "text",
      "id": "watermark",
      "label": "Watermark",
      "default": "連絡"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "default": "hello.ourstupidity@gmail.com"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "WhatsApp link"
    },
    {
      "type": "text",
      "id": "direct_note",
      "label": "Direct contact note",
      "default": "Monday through Saturday / Pakistan Standard Time"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "SEND A MESSAGE."
    },
    {
      "type": "text",
      "id": "form_note",
      "label": "Form note",
      "default": "Required fields are marked *"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Contact page"
    }
  ]
}
{% endschema %}
